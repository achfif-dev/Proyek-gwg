# ─────────────────────────────────────────────
#  WHITE LABEL — konfigurasi BUILD-TIME (bukan runtime)
# ─────────────────────────────────────────────
# File ini HANYA memengaruhi metadata yang tidak bisa diubah lewat Setup
# Wizard di dalam aplikasi (karena dibaca browser SEBELUM JavaScript jalan):
#   - Judul tab browser & nama app saat di-"Add to Home Screen" (PWA)
#   - Nama & warna tema aplikasi saat di-build jadi APK (Capacitor)
#   - Package name (appId) APK Android — lihat capacitor.config.ts
#
# Untuk white-label perusahaan lain: cukup ganti nilai di bawah ini, lalu
# jalankan `npm run build` ulang. Branding yang TAMPIL DI DALAM aplikasi
# (logo, warna, nama di header, dsb) tetap diatur lewat Setup Wizard
# runtime (⚙️ Setup Aplikasi) — TIDAK perlu edit file ini untuk itu.
VITE_APP_TITLE=GWG Super App — Generasi Wangi Group
VITE_APP_SHORT_NAME=GWG App
VITE_APP_DESCRIPTION=Aplikasi manajemen konsinyasi Generasi Wangi Group
VITE_THEME_COLOR=#000000
# Package name Android (format domain terbalik, tanpa spasi/simbol).
# PENTING: kalau APK ini SUDAH pernah dirilis/diinstal orang, JANGAN ganti
# nilai ini — mengubahnya berarti Android menganggapnya aplikasi yang
# berbeda sama sekali (update tidak akan terpasang menimpa yang lama).
VITE_APP_ID=com.gwg.superapp

# ─────────────────────────────────────────────
#  Firebase & Super Admin bawaan (khusus instance Generasi Wangi Group)
