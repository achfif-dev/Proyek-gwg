# (src/config/appConfig.js), sehingga Setup Wizard TIDAK PERNAH otomatis
# muncul untuk fork/instance manapun — termasuk perusahaan lain yang belum
# sempat mengisi Firebase-nya sendiri (mereka diam-diam akan tersambung ke
# database GWG). Sekarang dipindah ke sini (dibaca saat build).
